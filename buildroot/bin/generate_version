#!/usr/bin/env bash
#
# generate_version
#
# Make a Version.h file to accompany CUSTOM_VERSION_FILE
# Invoked automatically by Arduino IDE
#
# Authors: jbrazio, thinkyhead, InsanityAutomation, rfinnie
#

set -e

# Only run if ALLOW_GENERATE_VERSION is set
if [[ "$ALLOW_GENERATE_VERSION" != "1" ]]; then
  echo "Skipping generate_version because ALLOW_GENERATE_VERSION is not set."
  exit 0
fi

DIR="${1:-Marlin}"
READ_FILE="${READ_FILE:-${DIR}/Version.h}"
WRITE_FILE="${WRITE_FILE:-${READ_FILE}}"

BRANCH="$(git -C "${DIR}" symbolic-ref -q --short HEAD 2>/dev/null || true)"
VERSION="$(git -C "${DIR}" describe --tags --first-parent 2>/dev/null || true)"

STRING_DISTRIBUTION_DATE="${STRING_DISTRIBUTION_DATE:-$(date '+%Y-%m-%d %H:%M')}"
SHORT_BUILD_VERSION="${SHORT_BUILD_VERSION:-${BRANCH}}"
DETAILED_BUILD_VERSION="${DETAILED_BUILD_VERSION:-${BRANCH}-${VERSION}}"
PROTOCOL_VERSION="1.0"

# Gets some misc options from their defaults
DEFAULT_MACHINE_UUID="${DEFAULT_MACHINE_UUID:-$(awk -F'"' \
  '/#define DEFAULT_MACHINE_UUID/{ print $2 }' < "${READ_FILE}")}"
MACHINE_NAME="${MACHINE_NAME:-$(awk -F'"' \
  '/#define MACHINE_NAME/{ print $2 }' < "${READ_FILE}")}"
PROTOCOL_VERSION="${PROTOCOL_VERSION:-$(awk -F'"' \
  '/#define PROTOCOL_VERSION/{ print $2 }' < "${READ_FILE}")}"
SOURCE_CODE_URL="${SOURCE_CODE_URL:-$(awk -F'"' \
  '/#define SOURCE_CODE_URL/{ print $2 }' < "${READ_FILE}")}"
WEBSITE_URL="${WEBSITE_URL:-$(awk -F'"' \
  '/#define WEBSITE_URL/{ print $2 }' < "${READ_FILE}")}"

# Write the generated Version.h in pieces so we can preserve any
# commented-out #define lines that were intentionally left disabled
# in the existing `Version.h` (for example: //#define DEFAULT_MACHINE_UUID ...)
> "${WRITE_FILE}"
/**
 * Marlin 3D Printer Firmware
 * Copyright (c) 2020 MarlinFirmware [https://github.com/MarlinFirmware/Marlin]
 *
 * Based on Sprinter and grbl.
 * Copyright (c) 2011 Camiel Gubbels / Erik van der Zalm
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or
 * (at your option) any later version.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program.  If not, see <https://www.gnu.org/licenses/>.
 *
 */
#pragma once

/**
 * THIS FILE IS AUTOMATICALLY GENERATED DO NOT MANUALLY EDIT IT.
 * IT DOES NOT GET COMMITTED TO THE REPOSITORY.
 *
 * Branch: ${BRANCH}
 * Version: ${VERSION}
 */

/**
 * Marlin release version identifier
 */
# Append the static header block (use single-quoted heredoc to avoid expansion)
cat >> "${WRITE_FILE}" <<'HEADER'
/**
 * THIS FILE IS AUTOMATICALLY GENERATED DO NOT MANUALLY EDIT IT.
 * IT DOES NOT GET COMMITTED TO THE REPOSITORY.
 *
 * Branch: ${BRANCH}
 * Version: ${VERSION}
 */

/**
 * Marlin release version identifier
 */
HEADER

# Short build version (always written)
echo "#define SHORT_BUILD_VERSION \"${SHORT_BUILD_VERSION}\"" >> "${WRITE_FILE}"

cat >> "${WRITE_FILE}" <<'HEADER2'

/**
 * Verbose version identifier which should contain a reference to the location
 * from where the binary was downloaded or the source code was compiled.
 */
HEADER2

# DETAILED_BUILD_VERSION (always written)
echo "#define DETAILED_BUILD_VERSION \"${DETAILED_BUILD_VERSION}\"" >> "${WRITE_FILE}"

cat >> "${WRITE_FILE}" <<'HEADER3'

/**
 * The STRING_DISTRIBUTION_DATE represents when the binary file was built,
 * here we define this default string as the date where the latest release
 * version was tagged.
 */
HEADER3

# STRING_DISTRIBUTION_DATE (always written)
echo "#define STRING_DISTRIBUTION_DATE \"${STRING_DISTRIBUTION_DATE}\"" >> "${WRITE_FILE}"

cat >> "${WRITE_FILE}" <<'HEADER4'

/**
 * The protocol for communication to the host. Protocol indicates communication
 * standards such as the use of ASCII, "echo:" and "error:" line prefixes, etc.
 * (Other behaviors are given by the firmware version and capabilities report.)
 */
HEADER4

# PROTOCOL_VERSION: preserve commented-out original line if present
if grep -qE "^[[:space:]]*//[[:space:]]*#define[[:space:]]+PROTOCOL_VERSION" "${READ_FILE}" >/dev/null 2>&1; then
  # copy the original commented line (first occurrence)
  grep -E "^[[:space:]]*//[[:space:]]*#define[[:space:]]+PROTOCOL_VERSION" "${READ_FILE}" | head -n1 >> "${WRITE_FILE}"
else
  echo "#define PROTOCOL_VERSION \"${PROTOCOL_VERSION}\"" >> "${WRITE_FILE}"
fi

cat >> "${WRITE_FILE}" <<'HEADER5'

/**
 * Defines a generic printer name to be output to the LCD after booting Marlin.
 */
HEADER5

# MACHINE_NAME (always written)
echo "#define MACHINE_NAME \"${MACHINE_NAME}\"" >> "${WRITE_FILE}"

cat >> "${WRITE_FILE}" <<'HEADER6'

/**
 * The SOURCE_CODE_URL is the location where users will find the Marlin Source
 * Code which is installed on the device. In most cases —unless the manufacturer
 * has a distinct Github fork— the Source Code URL should just be the main
 * Marlin repository.
 */
HEADER6

# SOURCE_CODE_URL: preserve commented-out original line if present
if grep -qE "^[[:space:]]*//[[:space:]]*#define[[:space:]]+SOURCE_CODE_URL" "${READ_FILE}" >/dev/null 2>&1; then
  grep -E "^[[:space:]]*//[[:space:]]*#define[[:space:]]+SOURCE_CODE_URL" "${READ_FILE}" | head -n1 >> "${WRITE_FILE}"
else
  echo "#define SOURCE_CODE_URL \"${SOURCE_CODE_URL}\"" >> "${WRITE_FILE}"
fi

cat >> "${WRITE_FILE}" <<'HEADER7'

/**
 * Default generic printer UUID.
 */
HEADER7

# DEFAULT_MACHINE_UUID: preserve commented-out original line if present
if grep -qE "^[[:space:]]*//[[:space:]]*#define[[:space:]]+DEFAULT_MACHINE_UUID" "${READ_FILE}" >/dev/null 2>&1; then
  grep -E "^[[:space:]]*//[[:space:]]*#define[[:space:]]+DEFAULT_MACHINE_UUID" "${READ_FILE}" | head -n1 >> "${WRITE_FILE}"
else
  echo "#define DEFAULT_MACHINE_UUID \"${DEFAULT_MACHINE_UUID}\"" >> "${WRITE_FILE}"
fi

cat >> "${WRITE_FILE}" <<'HEADER8'

/**
 * The WEBSITE_URL is the location where users can get more information such as
 * documentation about a specific Marlin release.
 */
HEADER8

# WEBSITE_URL: preserve commented-out original line if present
if grep -qE "^[[:space:]]*//[[:space:]]*#define[[:space:]]+WEBSITE_URL" "${READ_FILE}" >/dev/null 2>&1; then
  grep -E "^[[:space:]]*//[[:space:]]*#define[[:space:]]+WEBSITE_URL" "${READ_FILE}" | head -n1 >> "${WRITE_FILE}"
else
  echo "#define WEBSITE_URL \"${WEBSITE_URL}\"" >> "${WRITE_FILE}"
fi

echo "" >> "${WRITE_FILE}"
